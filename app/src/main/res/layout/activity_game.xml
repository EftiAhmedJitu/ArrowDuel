<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Core Game SurfaceView -->
    <com.arrowduel.game.engine.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top In-Game HUD -->
    <RelativeLayout
        android:id="@+id/hudTop"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <!-- Pause Button -->
        <ImageButton
            android:id="@+id/btnPause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_dark_btn"
            android:src="@drawable/ic_pause_dots"
            android:contentDescription="Pause" />

        <!-- Left Side: Player Round Wins Badge (Black Text as requested) -->
        <TextView
            android:id="@+id/tvTournamentPlayerWins"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_toEndOf="@id/btnPause"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_badge_black_text"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="YOU: 0 WINS"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Level Indicator & Stars in Center -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGameTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LEVEL 12"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTournamentScoreMiddle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCORE: 0 - 0"
                android:textColor="@color/neon_gold"
                android:textSize="17sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/hudStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star_filled" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_star_filled" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_star_filled" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Side: Opponent Round Wins Badge (Black Text as requested) -->
        <TextView
            android:id="@+id/tvTournamentOpponentWins"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_toStartOf="@id/layoutCoinsCounter"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_badge_black_text_red"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="OPPONENT: 0 WINS"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Coins Counter (Right) -->
        <LinearLayout
            android:id="@+id/layoutCoinsCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_currency_pill"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_coin" />

            <TextView
                android:id="@+id/tvGameCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="320"
                android:textColor="@color/text_gold"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Bottom Left: Fire / Instant Shoot Button (Left Side) -->
    <LinearLayout
        android:id="@+id/layoutShootBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="22dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnShoot"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:background="@drawable/bg_red_btn"
            android:src="@drawable/ic_bow"
            android:contentDescription="Fire" />

        <TextView
            android:id="@+id/tvAutoFireStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="FIRE"
            android:textColor="@color/neon_red"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Center: Power-Ups (Potion x3, Shield x2, Lightning x1) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Health Potion Powerup -->
        <LinearLayout
            android:id="@+id/btnPowerupPotion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neon_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_potion" />

            <TextView
                android:id="@+id/tvPotionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="x3"
                android:textColor="@color/neon_red"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Energy Shield Powerup -->
        <LinearLayout
            android:id="@+id/btnPowerupShield"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_neon_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_shield" />

            <TextView
                android:id="@+id/tvShieldCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="x2"
                android:textColor="@color/neon_blue"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Lightning Strike Powerup -->
        <LinearLayout
            android:id="@+id/btnPowerupLightning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_neon_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_lightning" />

            <TextView
                android:id="@+id/tvLightningCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="x1"
                android:textColor="@color/text_gold"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Right: Moveable Floating Virtual Joystick (Right Hand Control) -->
    <com.arrowduel.game.views.VirtualJoystickView
        android:id="@+id/virtualJoystick"
        android:layout_width="180dp"
        android:layout_height="150dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp" />

    <!-- PAUSE DIALOG OVERLAY (Panel 11) -->
    <LinearLayout
        android:id="@+id/overlayPause"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black_overlay"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neon_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:text="PAUSED"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnResume"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_green_btn"
                android:text="RESUME"
                android:textColor="@color/bg_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPauseFps"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_blue_btn"
                android:text="60 FPS"
                android:textColor="@color/bg_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPauseRestart"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dark_btn"
                android:text="RESTART"
                android:textColor="@color/bg_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPauseLeave"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_red_btn"
                android:text="LEAVE MATCH"
                android:textColor="@color/bg_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- VICTORY DIALOG OVERLAY (Panel 12) -->
    <LinearLayout
        android:id="@+id/overlayVictory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black_overlay"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_victory"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvVictoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:text="VICTORY!"
                android:textColor="@color/neon_green"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- 3 Golden Stars -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/vStar1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_star_filled" />

                <ImageView
                    android:id="@+id/vStar2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_star_filled" />

                <ImageView
                    android:id="@+id/vStar3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_star_filled" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="REWARDS"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- Rewards line -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_coin" />

                <TextView
                    android:id="@+id/tvRewardCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="+120"
                    android:textColor="@color/text_gold"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="14dp"
                    android:src="@drawable/ic_gem" />

                <TextView
                    android:id="@+id/tvRewardGems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="+10"
                    android:textColor="@color/neon_blue"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnNextLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_play_btn"
                android:text="NEXT LEVEL"
                android:textColor="@color/bg_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/btnVictoryMainMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_blue_btn"
                android:text="MAIN MENU"
                android:textColor="@color/bg_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- DEFEAT DIALOG OVERLAY (Panel 13) -->
    <LinearLayout
        android:id="@+id/overlayDefeat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black_overlay"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_defeat"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvDefeatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:text="DEFEAT!"
                android:textColor="@color/neon_red"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Keep practicing your aim!"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_play_btn"
                android:text="RETRY"
                android:textColor="@color/bg_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/btnDefeatMainMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_blue_btn"
                android:text="MAIN MENU"
                android:textColor="@color/bg_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.04"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
