<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="50dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_dark_btn"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/tvMultiplayerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="HOTSPOT MULTIPLAYER"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLangToggle"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_tab_active_gold"
            android:text="🌐 বাংলা / ENG"
            android:textColor="#0A0E1A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />
    </RelativeLayout>

    <!-- Hotspot Instruction Banner -->
    <TextView
        android:id="@+id/tvHotspotBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_currency_pill"
        android:gravity="center"
        android:padding="5dp"
        android:text="🔥 Hotspot Mode: Turn on Hotspot on Phone 1, connect Phone 2 to it, then Host &amp; Join!"
        android:textColor="@color/text_gold"
        android:textSize="11sp" />

    <!-- Main Container: Left Options, Right Live Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- Left Actions Scrollable -->
        <ScrollView
            android:layout_width="250dp"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- CREATE ROOM BUTTON -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCreateRoom"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_play_btn"
                    android:text="CREATE ROOM (HOST)"
                    android:textColor="#0A0E1A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- JOIN ROOM BUTTON -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnJoinRoom"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_blue_btn"
                    android:text="JOIN ROOM (CLIENT)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- TOURNAMENT SELECTION CARD -->
                <LinearLayout
                    android:id="@+id/cardTournament"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_neon_card"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tvTournamentTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏆 TOURNAMENT / টুর্নামেন্ট"
                        android:textColor="@color/neon_gold"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnModeQuick"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tab_inactive"
                            android:text="QUICK (1v1)"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnModeTournament"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tab_active_gold"
                            android:text="🏆 TOURNAMENT"
                            android:textColor="#0A0E1A"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutRoundSelector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnRound3"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tab_active_gold"
                            android:text="3 ROUNDS"
                            android:textColor="#0A0E1A"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnRound5"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tab_inactive"
                            android:text="5 ROUNDS"
                            android:textColor="@color/text_primary"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnRound7"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tab_inactive"
                            android:text="7 ROUNDS"
                            android:textColor="@color/text_primary"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnRound10"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tab_inactive"
                            android:text="10 ROUNDS"
                            android:textColor="@color/text_primary"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvTournamentDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Best of 3: First to 2 wins is Champion!"
                        android:textColor="@color/text_cyan"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- QUICK 1v1 MATCH -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnQuickMatch"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_blue_btn"
                    android:text="VS AI DUEL (OFFLINE)"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Your Device IP Info -->
                <TextView
                    android:id="@+id/tvDeviceIp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Your IP: 192.168.43.1"
                    android:textColor="@color/neon_blue"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <!-- Connection Guide Button -->
                <Button
                    android:id="@+id/btnShowGuide"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_currency_pill"
                    android:text="📖 কীভাবে খেলবেন? (GUIDE)"
                    android:textColor="@color/bg_dark"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

        <!-- Right Side: Active Status & Connection Panel -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_neon_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Status Header -->
            <TextView
                android:id="@+id/tvStatusHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT CREATE OR JOIN"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Radar / Target Graphic -->
            <ImageView
                android:id="@+id/ivRadar"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/ic_target" />

            <!-- Status Subtitle -->
            <TextView
                android:id="@+id/tvStatusSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Ready for local duel battle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Host IP Input Layout (Visible for Join Room) -->
            <LinearLayout
                android:id="@+id/layoutJoinInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etHostIp"
                    android:layout_width="160dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_currency_pill"
                    android:gravity="center"
                    android:hint="Host IP"
                    android:text="192.168.43.1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnConnectNow"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_green_btn"
                    android:text="CONNECT"
                    android:textColor="@color/bg_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Cancel Button -->
            <Button
                android:id="@+id/btnCancelAction"
                android:layout_width="120dp"
                android:layout_height="36dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_red_btn"
                android:text="CANCEL"
                android:textColor="@color/bg_dark"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
