<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Real Artwork Logo & Animated Archers Clash View -->
    <com.arrowduel.game.views.AnimatedSplashView
        android:id="@+id/animatedSplashView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 4-Second Loading Bar and Stage Progress Text -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLoadingStage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="INITIALIZING BATTLE ENGINE... 0%"
            android:textColor="@color/neon_blue"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="260dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_blue_btn" />
    </LinearLayout>

</RelativeLayout>
