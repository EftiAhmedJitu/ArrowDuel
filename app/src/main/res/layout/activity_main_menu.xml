<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <!-- Player Profile (Left) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_currency_pill"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_avatar_archer" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPlayerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Player123"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlayerLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LVL 12"
                    android:textColor="@color/neon_blue"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Center Small Logo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="ARROW DUEL"
            android:textColor="@color/neon_blue"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <!-- Currencies (Right) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Coins Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_currency_pill"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_coin" />

                <TextView
                    android:id="@+id/tvCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="640"
                    android:textColor="@color/text_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="+"
                    android:textColor="@color/neon_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Gems Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_currency_pill"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_gem" />

                <TextView
                    android:id="@+id/tvGems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="120"
                    android:textColor="@color/text_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="+"
                    android:textColor="@color/neon_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- Center Emblem Backdrop Visual with real artwork logo -->
    <ImageView
        android:id="@+id/centerLogo"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_above="@+id/buttonContainer"
        android:layout_below="@+id/headerBar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:src="@drawable/logo_arrow_duel"
        android:scaleType="fitCenter" />

    <!-- Left Side Utility Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <!-- Settings Button -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_dark_btn"
            android:text="Settings"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textColor="@color/bg_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Leaderboard Button -->
        <Button
            android:id="@+id/btnLeaderboard"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dark_btn"
            android:text="Leaderboard"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textColor="@color/bg_dark"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Friends Button -->
        <Button
            android:id="@+id/btnFriends"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dark_btn"
            android:text="Friends"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textColor="@color/bg_dark"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Right Side Utility Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="14dp"
        android:orientation="vertical">

        <!-- Missions Button -->
        <Button
            android:id="@+id/btnMissions"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_dark_btn"
            android:text="Missions"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textColor="@color/bg_dark"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Daily Rewards Button -->
        <Button
            android:id="@+id/btnDailyRewards"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dark_btn"
            android:text="Daily Rewards"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textColor="@color/bg_dark"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- More Games Button -->
        <Button
            android:id="@+id/btnMoreGames"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_dark_btn"
            android:text="More Games"
            android:singleLine="true"
            android:textAllCaps="false"
            android:textColor="@color/bg_dark"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Bottom Main Action Buttons -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:orientation="vertical">

        <!-- Big PLAY Button -->
        <Button
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_play_btn"
            android:text="PLAY"
            android:textColor="@color/bg_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- MULTIPLAYER Button -->
        <Button
            android:id="@+id/btnMultiplayer"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_blue_btn"
            android:text="MULTIPLAYER  >"
            android:textColor="@color/bg_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- SHOP Button -->
        <Button
            android:id="@+id/btnShop"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_dark_btn"
            android:text="SHOP  >"
            android:textColor="@color/bg_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- CUSTOMIZE Button -->
        <Button
            android:id="@+id/btnCustomize"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_dark_btn"
            android:text="CUSTOMIZE  >"
            android:textColor="@color/bg_dark"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
