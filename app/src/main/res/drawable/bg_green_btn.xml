<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#80FF80">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="90"
                android:startColor="#008844"
                android:endColor="#00CC66"
                android:type="linear" />
            <stroke
                android:width="1.5dp"
                android:color="#44FF88" />
        </shape>
    </item>
</ripple>
